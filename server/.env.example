# Copy to .env and fill in your values

# Option 1: full connection URL (Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/education_management

# Option 2: individual fields (local Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=education_management

# JWT
JWT_SECRET=your-very-long-secret-key-at-least-32-chars
JWT_EXPIRES_IN=15m

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
